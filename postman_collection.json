            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Generate Alertes",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/alertes/generate/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
